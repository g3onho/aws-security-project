############################################
# 예시 변수 파일. 복사해서 terraform.tfvars 로 쓰세요.
#   Copy-Item .\terraform.tfvars.example .\terraform.tfvars
# terraform.tfvars 와 *.tfstate, *.pem 은 절대 Git 에 올리지 마세요.
############################################

project   = "soar-sec"
env       = "dev"
team_name = "team2"
region    = "ap-northeast-2"

# 비워두면 실행 PC 공인 IP/32 가 자동 적용됩니다. 팀 공용이면 사무실 대역/32 로.
admin_cidr = ""

############################################
# 비용 토글 — 발표/시연 직전에만 켜세요.
############################################
enable_nat_gateway   = true   # 끄면 Private EC2(대시보드) 설치 실패
enable_vpc_endpoints = true   # SSM 접속용 (NAT 대신)
enable_alb           = true   # 대시보드 접속(ALB :8080) + SEC-08(WAF)
enable_waf           = true   # enable_alb=true 와 함께 (SEC-08)
enable_dvwa_instance = true
enable_attacker_instance = false  # 내부 공격 재현 시 true

############################################
# 탐지 서비스 — 기본 전부 켜짐. 비용 걱정되면 개별 false.
############################################
# enable_guardduty       = true
# enable_inspector2      = true
# enable_config          = true
# enable_security_hub    = true
# enable_access_analyzer = true
# enable_cloudtrail      = true

# GuardDuty AI Protection (별도 과금)
enable_guardduty_ai_protection = false

############################################
# 자동조치
############################################
enable_auto_remediation = true   # false 면 전체 dry-run(판단만)
alert_email             = ""     # 예: "team2-secops@example.com"

# 규칙 ID 정확 일치 자동 조치 + SEC-06A(MySQL)·SEC-06B(SSH 22 거부) NACL 자동 차단 (decisions.md DEC-017~019).
# 기본값은 variables.tf 참고. 끄려면 항목을 뺀다. 예: 발표 전 NACL 자동 차단만 끄기
# auto_remediable_controls = ["EC2.2", "EC2.7", "EC2.182", "S3.1", "IAM.7", "SSM.6", "SSM.7"]
# ssh_reject_alarm_threshold = 10
# 주의: auto_remediable_patterns·auto_remediable_controls·enable_auto_remediation 을 바꾸면 대시보드 user_data 도
# 바뀌어 대시보드 인스턴스가 새로 뜬다(로그인 계정 SQLite 초기화). 시연 직전에는 바꾸지 않는다.

############################################
# A6 AI 미끼서버(허니팟) — private-db 서브넷에 미끼 1대 (enable_nat_gateway = true 필요)
############################################
# enable_honeypot    = true
# enable_honeypot_ai = true   # Bedrock 가짜 셸·세션 분석. 모델 액세스 허용 필요
# honeypot_ai_model_id = "global.anthropic.claude-haiku-4-5-20251001-v1:0"  # Claude Haiku 4.5(기본값). 다른 모델을 쓰려면 해당 리전 추론 프로파일 ID 로 바꾼다
#
# 미끼 접속 → NACL 자동 차단: v26 부터 기본값에 HONEYPOT 이 들어 있어 enable_honeypot = true 만 하면 켜진다.
# 위 auto_remediable_controls 를 tfvars 에서 직접 지정했다면 그 목록에 "HONEYPOT" 을 직접 넣어야 한다.
# 목록은 기본값을 대체한다 — ["HONEYPOT"] 만 쓰면 기존 자동 조치 9개가 전부 꺼진다. (대시보드 인스턴스 재생성 — 위 주의 참고)
# auto_remediable_controls = ["EC2.2", "EC2.7", "EC2.182", "S3.1", "IAM.7", "SSM.6", "SSM.7", "SEC-06A", "SEC-06B", "HONEYPOT"]
#
# 자동 차단(NACL 1~99 Deny)의 기본 차단 기간과 자동 해제(v25). 대시보드 허니팟 화면에서 행마다 바꿀 수 있다.
# ip_block_default_ttl_hours = 1     # 0 이면 영구. 시연이면 1 권장(기본 24)
# enable_block_expiry        = true  # 만료된 차단을 5분마다 자동 해제

############################################
# DB 비밀번호 — 비우면 Secrets Manager 에 랜덤 생성.
# 값을 넣으면 tfstate 에 남으니 실습용으로만.
############################################
# mysql_root_password = "ChangeMe-Root-123!"
# mysql_app_password  = "ChangeMe-App-123!"

############################################
# 임계치 — 기획서 기준 80%
############################################
cpu_alarm_threshold       = 80
memory_alarm_threshold    = 80
mysql_auth_fail_threshold = 10
