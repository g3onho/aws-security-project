#!/bin/bash
# 지리별 공격자 노드 부트스트랩 — ${region_label}
# Docker 설치 후 hydra+nmap 이미지를 빌드해 둔다.
# 실제 공격은 SSM(ATK-*)이 "docker run attacker ..." 로 실행한다.
# 로그: /var/log/user-data.log
set -euxo pipefail
exec > >(tee -a /var/log/user-data.log) 2>&1

export DEBIAN_FRONTEND=noninteractive

# 기본 VPC 공인 서브넷이라 egress 는 즉시 가능하지만, apt 미러 일시 실패는 재시도로 넘긴다.
retry() {
  for i in $(seq 1 5); do
    "$@" && return 0
    echo "실패 ($i/5): $* — 15초 후 재시도" >&2; sleep 15
  done
  return 1
}

retry apt-get update -y
retry apt-get install -y ca-certificates curl docker.io
systemctl enable --now docker

mkdir -p /opt/attacker/wordlists

# hydra + nmap 이 든 작은 이미지
cat >/opt/attacker/Dockerfile <<'EOF'
FROM debian:stable-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends hydra nmap sqlmap ca-certificates \
 && rm -rf /var/lib/apt/lists/*
EOF

# 흔한 약한 비밀번호. DVWA(admin/password)와 SSH(victim/password123) 둘 다 걸리도록 포함.
# 개수를 늘려 시도량을 확보한다 — SSH BruteForce(GuardDuty)·WAF 차단(빨간선) 임계치를 넘기려면
# 소수로는 부족하다. hydra 는 -f 없이 전체 리스트를 시도한다.
cat >/opt/attacker/wordlists/pass.txt <<'EOF'
password
123456
admin
password123
qwerty
letmein
root
toor
ubuntu
P@ssw0rd
12345678
123456789
12345
1234567
1234567890
qwerty123
1q2w3e4r
abc123
