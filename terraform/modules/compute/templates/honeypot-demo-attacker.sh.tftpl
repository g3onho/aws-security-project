#!/bin/bash
# 허니팟 AI 시연용 공격자 (옵션). 팀 소유 격리 VPC 에서만 사용.
# sshpass 만 설치한다. 공격 명령은 SSM 문서 ATK-HoneypotAiDemo 가 보낸다.
# 로그: /var/log/user-data.log
set -euxo pipefail
exec > >(tee -a /var/log/user-data.log) 2>&1

export DEBIAN_FRONTEND=noninteractive

# NAT 라우트가 붙기 전에 부팅하면 apt 가 타임아웃되므로 밖으로 나갈 수 있을 때까지 기다린다.
for i in $(seq 1 30); do
  curl -fsS --max-time 5 -o /dev/null http://archive.ubuntu.com/ && break
  echo "egress 대기 중 ($i/30)"; sleep 10
done

for i in $(seq 1 5); do
  apt-get update -y && apt-get install -y sshpass && break
  echo "실패 ($i/5) — 15초 후 재시도" >&2; sleep 15
done
command -v sshpass
