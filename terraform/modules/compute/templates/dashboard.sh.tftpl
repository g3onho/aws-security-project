#!/bin/bash
# SOAR 보안 대시보드 (Flask) — 코드 배포부터 서비스 기동까지 자동으로 끝낸다.
# 로그: /var/log/user-data.log
#
# 전제: NAT 가 켜져 있어야 apt / PyPI 에 나갈 수 있다(enable_nat_gateway = true).
# NAT 없이 쓰려면 휠을 미리 S3 에 올려두고 --no-index 로 설치하도록 바꿔야 한다.
set -euxo pipefail
exec > >(tee -a /var/log/user-data.log) 2>&1

export DEBIAN_FRONTEND=noninteractive

# NAT 라우트가 붙기 전에 부팅하면 apt·PyPI·curl 이 전부 타임아웃되고, set -e 로
# 부트스트랩이 통째로 중단된다 (2026-09-22 docker-host 사고 참고).
# 밖으로 나갈 수 있을 때까지 기다렸다가, 그 뒤 일시적 실패는 재시도로 넘긴다.
wait_for_net() {
  for i in $(seq 1 30); do
    curl -fsS --max-time 5 -o /dev/null http://archive.ubuntu.com/ && return 0
    echo "egress 대기 중 ($i/30)"; sleep 10
  done
  echo "5분간 외부로 나갈 수 없습니다. NAT 게이트웨이/라우트를 확인하세요." >&2
  return 1
}
retry() {
  for i in $(seq 1 5); do
    "$@" && return 0
    echo "실패 ($i/5): $* — 15초 후 재시도" >&2; sleep 15
  done
  return 1
}

wait_for_net
retry apt-get update -y
retry apt-get install -y ca-certificates curl unzip jq python3-pip python3-venv

retry curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -oq /tmp/awscliv2.zip -d /tmp && /tmp/aws/install --update

mkdir -p /opt/dashboard

# 대시보드 코드가 참조할 리소스 이름. 서비스가 EnvironmentFile 로 읽는다.
# DATA_PROVIDER=aws and WRITE_ENABLED=true enable live AWS reads and action execution.
cat > /opt/dashboard/dashboard.env <<ENVEOF
DATA_PROVIDER=aws
AWS_REGION=${region}
WRITE_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_INSTANCE=/opt/dashboard/instance
CORRELATED_FINDINGS_TABLE=${correlated_findings_table}
REMEDIATION_ACTIONS_TABLE=${remediation_actions_table}
# 허니팟 화면·차단 IP 관리(v25). 허니팟 로그 그룹이 비면 화면은 "허니팟 미배포"로 표시한다.
IP_BLOCKLIST_TABLE=${ip_blocklist_table}
HONEYPOT_LOG_GROUP=${honeypot_log_group}
HONEYPOT_ALARM_NAME=${honeypot_alarm_name}
PRIVATE_NACL_ID=${private_nacl_id}
VPC_CIDR=${vpc_cidr}
DOC_UNBLOCK_IP=ASR-UnblockIpWithNacl
AUTOMATION_ROLE_ARN=${automation_role_arn}
FINDINGS_TABLE=${findings_table}
VULNERABILITIES_TABLE=${vulnerabilities_table}
EVENT_SOURCE=${event_source}
VULNERABILITY_SOURCE=${vulnerability_source}
SCAN_RESULTS_BUCKET=${scan_results_bucket}
SNS_TOPIC_ARN=${sns_topic_arn}
NAME_PREFIX=${project}
AUTO_REMEDIABLE_PATTERNS=${auto_remediable_patterns}
AUTO_REMEDIABLE_CONTROLS=${auto_remediable_controls}
ENABLE_AUTO_REMEDIATION=${enable_auto_remediation}
ATTACK_REGIONS=us-east-1,ap-southeast-1,ap-southeast-2,ap-south-1,ap-northeast-1
ATTACK_DOCUMENT_NAME=${project}-ATK-WebAttack
DVWA_TARGET_IP=${dvwa_target_ip}
# 웹 공격은 ALB(WAF 경유) 대상이라야 빨간 흐름선이 뜬다. DVWA IP:80 직접은 filtered.
DVWA_WEB_URL=${dvwa_web_url}
ENVEOF

############################################
# 코드 내려받기
# ${code_version} 은 zip 의 MD5 다. 코드가 바뀌면 이 값이 바뀌어 user_data 가
# 갱신되고, user_data_replace_on_change 로 인스턴스가 새 코드로 다시 뜬다.
############################################
echo "deploying dashboard code (version ${code_version})"
aws s3 cp "s3://${scan_results_bucket}/deploy/dashboard.zip" /tmp/dashboard.zip --region ${region}
rm -rf /opt/dashboard/app-src
mkdir -p /opt/dashboard/app-src
unzip -oq /tmp/dashboard.zip -d /opt/dashboard/app-src

APP=/opt/dashboard/app-src/backend
test -f "$APP/run.py"   # 구조가 예상과 다르면 여기서 멈춘다

############################################
# 의존성 (NAT 필요)
############################################
python3 -m venv /opt/dashboard/venv
/opt/dashboard/venv/bin/pip install --upgrade pip
/opt/dashboard/venv/bin/pip install -r "$APP/requirements.txt"

############################################
# 초기 계정 — 없을 때만 만든다. 암호는 instance/initial-login.txt 에 남는다.
############################################
mkdir -p /opt/dashboard/instance
set -a; . /opt/dashboard/dashboard.env; set +a
cd "$APP" && /opt/dashboard/venv/bin/python run.py --init-admin || true

############################################
# systemd 서비스 — 부팅 때 자동 시작, 죽으면 재시작
# --lan 으로 0.0.0.0 에 열어야 ALB 헬스체크와 포워딩이 닿는다.
# 외부 노출은 보안그룹이 막는다(ALB 와 관리자 CIDR 만 허용).
############################################
cat > /etc/systemd/system/dashboard.service <<'UNITEOF'
[Unit]
Description=SOAR Security Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/dashboard/app-src/backend
EnvironmentFile=/opt/dashboard/dashboard.env
ExecStart=/opt/dashboard/venv/bin/python run.py --host 0.0.0.0 --port 5000
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
UNITEOF

systemctl daemon-reload
systemctl enable --now dashboard.service

# 기동 확인. 실패해도 user_data 를 멈추지 않고 상태만 로그에 남긴다.
for i in $(seq 1 30); do
  if curl -fsS http://127.0.0.1:5000/health >/dev/null 2>&1; then
    echo "dashboard is up"
    break
  fi
  sleep 2
done
systemctl status dashboard.service --no-pager || true

# CloudWatch Agent — 메모리 지표(SEC-10 알람 · 대시보드 인프라 모니터링).
# 리전 버킷을 쓴다(글로벌 엔드포인트는 S3 게이트웨이 엔드포인트로 라우팅되지 않음).
# 모니터링 실패가 본 서비스 부트스트랩을 막지 않도록 전부 || true.
retry curl -fsSL https://amazoncloudwatch-agent-${region}.s3.${region}.amazonaws.com/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb -o /tmp/cwagent.deb || true
apt-get install -y -o DPkg::Lock::Timeout=300 /tmp/cwagent.deb || true
mkdir -p /opt/aws/amazon-cloudwatch-agent/etc
cat > /opt/aws/amazon-cloudwatch-agent/etc/cw.json <<CWJSON
{
  "agent": { "metrics_collection_interval": 60, "run_as_user": "root" },
  "metrics": {
    "namespace": "${project}/host",
    "append_dimensions": { "InstanceId": "\$${aws:InstanceId}" },
    "metrics_collected": {
      "mem": { "measurement": [ { "name": "mem_used_percent", "rename": "MemoryUsedPercent" } ] }
    }
  }
}
CWJSON
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/cw.json || true

echo "dashboard ready on :5000"
