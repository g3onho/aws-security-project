#!/bin/bash
# Docker Host - Nginx + Flask + MySQL 3-Tier 서비스 (보호 대상)
# 로그: /var/log/user-data.log
set -euxo pipefail
exec > >(tee -a /var/log/user-data.log) 2>&1

export DEBIAN_FRONTEND=noninteractive

# NAT 라우트가 붙기 전에 부팅하면 apt·curl 이 전부 타임아웃되고, set -e 로 부트스트랩이
# 통째로 중단된다. 그러면 :80 이 안 떠서 ALB 가 502 를 낸다 (2026-09-22 docker-host 사고).
# 밖으로 나갈 수 있을 때까지 기다렸다가, 그 뒤 일시적 실패는 재시도로 넘긴다.
wait_for_net() {
  for i in $(seq 1 30); do
    curl -fsS --max-time 5 -o /dev/null http://archive.ubuntu.com/ && return 0
    echo "egress 대기 중 ($i/30)"; sleep 10
  done
  echo "5분간 외부로 나갈 수 없습니다. NAT 게이트웨이/라우트를 확인하세요." >&2
  return 1
}
retry() {
  for i in $(seq 1 5); do
    "$@" && return 0
    echo "실패 ($i/5): $* — 15초 후 재시도" >&2; sleep 15
  done
  return 1
}

wait_for_net
retry apt-get update -y
retry apt-get install -y ca-certificates curl gnupg unzip jq

# AWS CLI v2
retry curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -oq /tmp/awscliv2.zip -d /tmp && /tmp/aws/install --update

# Docker + Compose plugin
install -m 0755 -d /etc/apt/keyrings
# retry 는 파이프라인을 감쌀 수 없으므로 내려받기와 변환을 나눈다.
retry curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /tmp/docker.gpg
gpg --dearmor -o /etc/apt/keyrings/docker.gpg < /tmp/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list
retry apt-get update -y
retry apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
systemctl enable --now docker

# CloudWatch Agent
# 리전 버킷을 쓴다 — 글로벌 엔드포인트(amazoncloudwatch-agent.s3.amazonaws.com)는
# S3 게이트웨이 엔드포인트로 라우팅되지 않아 NAT 없는 프라이빗 서브넷에서 실패한다. - Nginx access/error 로그 분리 수집 (Docker 체크리스트 #25~27, SEC-09)
retry curl -fsSL https://amazoncloudwatch-agent-${region}.s3.${region}.amazonaws.com/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb -o /tmp/cwagent.deb
apt-get install -y -o DPkg::Lock::Timeout=300 /tmp/cwagent.deb || true

cat > /opt/aws/amazon-cloudwatch-agent/etc/cw.json <<CWJSON
{
  "agent": { "metrics_collection_interval": 60, "run_as_user": "root" },
  "metrics": {
    "namespace": "${project}/host",
    "append_dimensions": { "InstanceId": "\$${aws:InstanceId}" },
    "metrics_collected": {
      "mem": { "measurement": [ { "name": "mem_used_percent", "rename": "MemoryUsedPercent" } ] },
      "disk": { "measurement": [ "used_percent" ], "resources": [ "/" ] }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/log/nginx/access.log", "log_group_name": "${log_group_nginx}", "log_stream_name": "{instance_id}/access" },
          { "file_path": "/var/log/nginx/error.log",  "log_group_name": "${log_group_nginx}", "log_stream_name": "{instance_id}/error" }
        ]
      }
    }
  }
}
CWJSON
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/cw.json || true

# DB 자격증명은 Secrets Manager 에서 읽습니다 (하드코딩 금지 - 체크리스트 #9)
SECRET_JSON=$(aws secretsmanager get-secret-value --region ${region} --secret-id ${db_secret_name} --query SecretString --output text)
APP_USER=$(echo "$SECRET_JSON" | jq -r .app_user)
APP_PW=$(echo "$SECRET_JSON" | jq -r .app_password)
ROOT_PW=$(echo "$SECRET_JSON" | jq -r .root_password)

mkdir -p /opt/app/nginx /var/log/nginx
cd /opt/app

# .env 는 컨테이너에만 주입하고 이미지/깃에는 넣지 않습니다 (#10, #24)
cat > /opt/app/.env <<ENVEOF
MYSQL_ROOT_PASSWORD=$ROOT_PW
MYSQL_DATABASE=${db_name}
MYSQL_USER=$APP_USER
MYSQL_PASSWORD=$APP_PW
ENVEOF
chmod 600 /opt/app/.env

# frontend / backend 네트워크 분리, DB 포트 미공개, 이미지 태그 고정 (#3,#5,#6,#19,#20,#21)
cat > /opt/app/compose.yaml <<'COMPOSE'
services:
  nginx:
    image: nginx:1.27-bookworm
    ports:
      - "80:80"
    depends_on: [web]
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
      - /var/log/nginx:/var/log/nginx
    networks: [frontend]
    restart: unless-stopped
  web:
    image: ${ecr_repository_url}:app-1.0.0
    environment:
      DB_HOST: db
      DB_NAME: ${db_name}
      DB_USER: ${db_app_user}
    env_file: [.env]
    expose:
      - "5000"
    depends_on:
      db: { condition: service_healthy }
    networks: [frontend, backend]
    user: "10001:10001"
    restart: unless-stopped
  db:
    image: mysql:8.4
    env_file: [.env]
    volumes:
      - db_data:/var/lib/mysql
    networks: [backend]
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-p$${MYSQL_ROOT_PASSWORD}"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped
networks:
  frontend: {}
  backend:
    internal: true
volumes:
  db_data: {}
COMPOSE

# Nginx 기본 설정 (SEC-02 시작 상태: 평문 HTTP, 보안 헤더 없음 -> 개선 스크립트가 교체)
cat > /opt/app/nginx/default.conf <<'NGINX'
server {
    listen 80;
    server_name _;
    location /health { return 200 "ok\n"; add_header Content-Type text/plain; }
    location / {
        proxy_pass http://web:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
NGINX

# 스택 기동을 systemd 에 맡긴다. 컨테이너는 restart: unless-stopped 라 재부팅은 docker 가
# 알아서 복구하므로, 자동화가 필요한 건 "최초 up -d" 한 번뿐이다.
# ECR 이미지(app-1.0.0)가 아직 없으면 이 유닛은 실패한다 — push 되면 저절로 올라오도록 재시도하되,
# 이미지가 영영 안 오는 동안 journal 이 차지 않게 1시간에 5번으로 끊는다.
cat > /etc/systemd/system/app.service <<'UNIT'
[Unit]
Description=3-tier service stack (docker compose)
Requires=docker.service
After=docker.service
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/app
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
# ECR 이미지가 없으면 여기서 실패하는 게 정상이다. user-data 를 죽이지 않는다.
systemctl enable --now app.service || true

echo "docker-host user-data done. app.service 가 compose 를 기동합니다."
echo "  ECR push 전이면 60초 간격 5회 시도 후 멈춥니다 — push 후 'systemctl start app' 한 번."
